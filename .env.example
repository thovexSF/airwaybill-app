VITE_APP_ENV=development
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Partner API (server-side; also used by `npm start` / Railway)
# REQUIRED on Railway for /v1/* and migrations from B2B:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: public URL used in embed SSO links
# PUBLIC_APP_URL=https://airwaybill.app

# In-app feedback widget (calls supabase/functions/feedback)
# Set to false to hide the floating button without removing code
VITE_FEEDBACK_ENABLED=true

# PostHog (analytics)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_key_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Paddle (payments)
VITE_PADDLE_ENV=production
VITE_PADDLE_CLIENT_TOKEN=live_xxx
VITE_PADDLE_PRICE_STARTER=pri_xxx
VITE_PADDLE_PRICE_PRO=pri_xxx
